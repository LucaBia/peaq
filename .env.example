# Copy to .env for local development (gitignored). The VITE_* values are public
# (they ship in the browser bundle). For the deployed site these come from the
# Cloudflare Worker config, NOT this file — see setup/README.md.

# --- Supabase (public: URL + anon/publishable key) ---
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# --- Secrets (NEVER commit real values; in prod set as Cloudflare secrets) ---
# Used server-side only for the waitlist welcome email.
RESEND_API_KEY=""
